    def _save_interaction(
        self, 
        db: Session, 
        user_id: str, 
        interaction_type: str,
        prompt: str,
        response: Dict[str, Any],
        tokens_used: int,
        response_time: int,
        metadata: Optional[Dict[str, Any]] = None
    ) -> LLMInteraction:
        
        # Create hash of input for deduplication
        input_hash = hashlib.sha256(
            f"{user_id}:{prompt}".encode()
        ).hexdigest()[:128]
        
        interaction = LLMInteraction(
            user_id=user_id,
            interaction_type=interaction_type,
            model=self.model,
            input_hash=input_hash,
            output_metadata={
                "prompt": prompt,
                "response": response["content"],
                **metadata
            } if metadata else {
                "prompt": prompt,
                "response": response["content"]
            },
            tokens_used=tokens_used,
            response_time_ms=response_time
        )
        
        db.add(interaction)
        db.commit()
        db.refresh(interaction)
        return interaction

    async def audit_response(
        self,
        db: Session,
        user_id: str,
        ai_response: str,
        original_query: str,
        context: Optional[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        
        audit_prompt = f"""You are an AI auditor. Analyze the following AI response for accuracy, bias, and reasoning quality.

Original query: {original_query}

AI response: {ai_response}

Context: {json.dumps(context, indent=2) if context else "No additional context"}

Please evaluate:
1. Is the response accurate based on available evidence?
2. Are there any hallucinations or fabrications?
3. Are the inferences properly labeled as such?
4. Is the confidence level appropriate?
5. Are there any biases or assumptions?

Provide a detailed audit with specific issues and corrections."""

        messages = [
            {"role": "system", "content": "You are an AI auditor specializing in evaluating AI-generated content for accuracy and reasoning quality."},
            {"role": "user", "content": audit_prompt}
        ]
        
        start_time = time.time()
        response = await self._call_llm(messages)
        response_time = int((time.time() - start_time) * 1000)
        
        # Parse audit response
        audit_result = self._parse_audit_response(response["content"])
        
        # Save interaction
        self._save_interaction(
            db, user_id, "audit",
            audit_prompt, response,
            tokens_used=response.get("tokens_used", 0),
            response_time=response_time,
            metadata={"audit": audit_result}
        )
        
        return audit_result

    def _parse_audit_response(self, audit_text: str) -> Dict[str, Any]:
        # Parse the audit response into structured data
        # This is a simplified version - you'd want more robust parsing
        return {
            "is_accurate": True if "accurate" in audit_text.lower() else False,
            "confidence_score": 85,  # Would extract from text
            "issues": [
                {"type": "hallucination", "description": "Example issue", "severity": "high"}
            ],
            "corrections": [
                {"original": "Example", "corrected": "Corrected version", "reason": "Reason"}
            ],
            "reasoning": audit_text
        }

    async def process_feedback(
        self,
        db: Session,
        user_id: str,
        interaction_id: str,
        correct_response: str,
        feedback_type: str,
        explanation: Optional[str] = None
    ) -> Dict[str, Any]:
        
        # Get original interaction
        interaction = db.query(LLMInteraction).filter(
            LLMInteraction.id == interaction_id
        ).first()
        
        if not interaction:
            raise Exception("Interaction not found")
        
        # Update interaction with feedback
        if interaction.evaluation is None:
            interaction.evaluation = {}
        
        interaction.evaluation.update({
            "feedback": {
                "type": feedback_type,
                "correct_response": correct_response,
                "explanation": explanation,
                "user_id": user_id,
                "timestamp": datetime.now().isoformat()
            }
        })
        
        db.commit()
        db.refresh(interaction)
        
        return {
            "message": "Feedback recorded successfully",
            "interaction_id": str(interaction.id)
        }
